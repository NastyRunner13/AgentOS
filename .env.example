# OpenRouter is the default provider (config/models.yaml).
OPENROUTER_API_KEY=

# Used only if you point a role at these providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Voice STT when config/voice.yaml stt.engine is groq.
GROQ_API_KEY=

# web_search uses DuckDuckGo HTML by default. No key required.
# Optional Brave fallback when DDG blocks (config/permissions.yaml web.fallback).
BRAVE_API_KEY=
